{
  "name": "vcanvas",
  "version": "1.11.18",
  "description": "inscanvas is a visual creative workspace for vision-language models. Draw, describe, generate.",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "server": "node --import tsx server/index.ts",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:gh": "node scripts/build-gh.mjs",
    "desktop": "npm run build:desktop && electron .",
    "dist:desktop": "npm run build:desktop && electron-builder",
    "dist:desktop:ci": "npm run build:desktop && electron-builder --publish never",
    "preview": "vite preview",
    "proxy": "node scripts/custom-openai-proxy.mjs"
  },
  "license": "MIT",
  "author": {
    "name": "xiaoli0412",
    "email": "222041974+xiaoli0412@users.noreply.github.com",
    "url": "https://github.com/xiaoli0412"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.0",
    "@fastify/static": "^8.3.0",
    "fastify": "^5.6.1",
    "html2canvas": "^1.4.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "electron": "^36.2.0",
    "electron-builder": "^26.0.12",
    "icon-gen": "^5.0.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.3"
  },
  "build": {
    "appId": "ai.e01.vcanvas",
    "productName": "inscanvas",
    "copyright": "Copyright © 2026 inscanvas",
    "electronDownload": {
      "mirror": "https://npmmirror.com/mirrors/electron/"
    },
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "scripts/proxy-server.cjs",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "assets/icons/app.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-Windows-Setup.${ext}"
    },
    "linux": {
      "icon": "assets/icons",
      "maintainer": "xiaoli0412 <222041974+xiaoli0412@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ],
      "artifactName": "${productName}-${version}-Linux-${arch}.${ext}",
      "category": "Graphics"
    },
    "mac": {
      "icon": "assets/icons/app.icns",
      "target": [
        "dmg"
      ],
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}",
      "category": "public.app-category.graphics-design"
    }
  }
}
